# ── Google Apps Script backend (google-apps-script/Code.gs) ─────────────────
# The web-app URL from Deploy → Manage deployments (ends in /exec)
APPS_SCRIPT_URL=
# Must match the SHARED_SECRET script property (long random string)
APPS_SCRIPT_SECRET=

# ── Admin sign-in ─────────────────────────────────────────────────────────────
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Permanent admin; everyone else is managed in the admin panel → Access
OWNER_EMAIL=rubayathdrjb@gmail.com
# 32+ random characters, signs the admin session cookie
SESSION_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Canonical URL, used for social share previews
NEXT_PUBLIC_SITE_URL=https://www.modesociety.com.au
# Local only: shows a "Dev sign-in" button on /admin when running `npm run dev`
ADMIN_DEV_BYPASS=false
